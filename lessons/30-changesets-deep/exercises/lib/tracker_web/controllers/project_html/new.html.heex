<Layouts.app flash={@flash}>
  <.header>New project</.header>

  <.form for={@form} action={~p"/projects"}>
    <.input field={@form[:name]} label="Name" />
    <.input
      field={@form[:status]}
      type="select"
      prompt="Choose a status"
      options={Ecto.Enum.values(Tracker.Projects.Project, :status)}
      label="Status"
    />
    <.button>Save</.button>
  </.form>
</Layouts.app>
